# =====================================================================
# CloudLens configuration. Copy to .env and edit:   cp .env.example .env
# Never commit .env (it is in .gitignore).
# =====================================================================

# ---------- General ----------
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata
# dashboard port on the host (80 on EC2)
HTTP_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# used for links inside Slack/Teams messages
DASHBOARD_PUBLIC_URL=http://localhost:8080

# ---------- PostgreSQL ----------
POSTGRES_DB=cloudlens
POSTGRES_USER=cloudlens
POSTGRES_PASSWORD=change-me-db-password
# Only used when running the backend outside Docker:
DATABASE_URL=postgresql+psycopg://cloudlens:change-me-db-password@localhost:5432/cloudlens

# ---------- Authentication ----------
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRE_MINUTES=480
# Default users created on first start (change the passwords!)
ADMIN_EMAIL=admin@cloudlens.dev
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Administrator
VIEWER_EMAIL=viewer@cloudlens.dev
VIEWER_PASSWORD=Viewer@123
VIEWER_NAME=Read-only Viewer

# ---------- Data source switch ----------
# mock -> built-in realistic data generator, no cloud credentials needed (default)
# live -> real AWS / Azure / GCP APIs using the credentials below
DATA_SOURCE=mock
ENABLED_PROVIDERS=aws,azure,gcp
# tag / label holding prod / staging / dev
ENV_TAG_KEY=environment
# history loaded on first start (AWS Cost Explorer max ~14 months)
BACKFILL_DAYS=365
# providers restate recent days; re-fetch them daily
SYNC_LOOKBACK_DAYS=3

# ---------- AWS (Cost Explorer, EC2, RDS, CloudWatch) ----------
# Option A (recommended on EC2): attach an IAM role to the instance and set this to true
AWS_USE_DEFAULT_CREDENTIALS=false
# Option B: access keys of an IAM user with deploy/aws/iam-policy.json attached
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=
# comma separated regions to scan for EC2/RDS
AWS_REGIONS=ap-south-1
# Cost Explorer endpoint is global (us-east-1)
AWS_COST_EXPLORER_REGION=us-east-1

# ---------- Azure (Cost Management, Resource Manager, Monitor) ----------
# Service principal with "Cost Management Reader" + "Monitoring Reader" + "Reader" on the subscription
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# ---------- GCP (Cloud Billing API + BigQuery billing export + Cloud Monitoring) ----------
# Put the service-account key in ./secrets/gcp-key.json (mounted read-only into the backend)
GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
GCP_PROJECT_ID=
GCP_BILLING_ACCOUNT_ID=
# e.g. my-project.billing_export.gcp_billing_export_v1_0123AB_CDEF45_6789GH
GCP_BILLING_EXPORT_TABLE=

# ---------- Scheduler (APScheduler inside the backend) ----------
SCHEDULER_ENABLED=true
# 02:00 local time
DAILY_SYNC_HOUR=2
DAILY_SYNC_MINUTE=0
# utilization samples (near real time)
METRICS_INTERVAL_MINUTES=5
# mock: 15 is fine. live: use 360+ (AWS bills $0.01 per Cost Explorer call)
INTRADAY_COST_REFRESH_MINUTES=15
ALERT_EVAL_INTERVAL_SECONDS=60
METRICS_RETENTION_DAYS=90
COST_RETENTION_DAYS=730

# ---------- Alerting ----------
# alertmanager -> Prometheus scrapes rule state, Alertmanager calls the backend webhook (Docker default)
# direct       -> backend sends notifications itself (when running without Docker/Prometheus)
ALERT_DELIVERY=alertmanager
ALERTMANAGER_WEBHOOK_TOKEN=change-me-webhook-token
# Default: the bundled mock receiver (view messages at http://localhost:8080/mock-inbox/)
# Real: Slack incoming webhook  https://hooks.slack.com/services/XXX/YYY/ZZZ
#       Teams Workflows webhook https://prod-00.westus.logic.azure.com/workflows/...
SLACK_WEBHOOK_URL=http://mock-receiver:9000/slack
TEAMS_WEBHOOK_URL=http://mock-receiver:9000/teams
# slack | teams | both
DEFAULT_NOTIFICATION_CHANNEL=both

# ---------- Business defaults (editable later in Settings) ----------
DEFAULT_MONTHLY_BUDGET_USD=120000
DEFAULT_EXCHANGE_RATE_INR=84.20

# ---------- Docker build / monitoring ----------
# false = smaller backend image for mock-only use
INSTALL_CLOUD_SDKS=true
PROMETHEUS_RETENTION=15d
BACKEND_PORT=8000
